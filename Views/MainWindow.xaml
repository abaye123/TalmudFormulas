<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TalmudFormulas.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:TalmudFormulas.Views.Controls"
    Title="סינופסיס תלמוד בבלי - נוסחאות התלמוד"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid"
          FlowDirection="RightToLeft"
          Background="Transparent">
        <Grid.RowDefinitions>
            <!-- שורה 0: רצועת AppTitleBar בלתי-נראית (drag region) -->
            <RowDefinition Height="32" />
            <!-- שורה 1: header אפליקציה -->
            <RowDefinition Height="Auto" />
            <!-- שורה 2: גוף -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== AppTitleBar (drag area) ===== -->
        <!-- FlowDirection=LTR מבטיח שהיישור "Right" יישב בקצה הימני הויזואלי
             (לחצני המערכת עברו לשמאל בעקבות WS_EX_LAYOUTRTL) -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="32"
              Background="Transparent"
              FlowDirection="LeftToRight">
            <TextBlock Text="סינופסיס תלמוד בבלי"
                       FontSize="12"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="0,0,14,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- ===== HEADER ===== -->
        <Grid x:Name="HeaderBorder"
              Grid.Row="1"
              Padding="16,8,16,12"
              Background="Transparent">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- צד ימין (התחלת RTL): ניווט וכלי תצוגה -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <Button x:Name="SidebarToggleBtn"
                            Style="{StaticResource SubtleButtonStyle}"
                            Width="36" Height="36"
                            CornerRadius="8"
                            Padding="0"
                            ToolTipService.ToolTip="הצג/הסתר סרגל מסכתות"
                            Click="OnSidebarToggle">
                        <FontIcon x:Name="SidebarToggleIcon"
                                  FontFamily="{StaticResource SymbolThemeFontFamily}"
                                  Glyph="&#xE700;"
                                  FontSize="16" />
                    </Button>

                    <Button x:Name="WarnBtn"
                            Style="{StaticResource SubtleButtonStyle}"
                            Width="36" Height="36"
                            CornerRadius="8"
                            Padding="0"
                            ToolTipService.ToolTip="הערת שימוש"
                            Click="OnShowCopyrightNotice">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                                  Glyph="&#xE946;"
                                  FontSize="16" />
                    </Button>

                    <Button x:Name="SettingsBtn"
                            Style="{StaticResource SubtleButtonStyle}"
                            Width="36" Height="36"
                            CornerRadius="8"
                            Padding="0"
                            ToolTipService.ToolTip="הגדרות תצוגה"
                            Click="OnOpenSettings">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                                  Glyph="&#xE713;"
                                  FontSize="16" />
                    </Button>

                    <Border Width="1"
                            Margin="6,8"
                            Background="{ThemeResource ControlStrokeColorDefaultBrush}" />

                    <ToggleButton x:Name="ModeBtn"
                                  Height="36"
                                  Padding="14,0"
                                  CornerRadius="8"
                                  Checked="OnModeToggled"
                                  Unchecked="OnModeToggled">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="ModeIcon"
                                      FontFamily="{StaticResource SymbolThemeFontFamily}"
                                      Glyph="&#xE8D2;"
                                      FontSize="14" />
                            <TextBlock x:Name="ModeText"
                                       Text="תצוגת מילים"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>

                <!-- מרכז: כותרת + ניווט קדימה/אחורה -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="14"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Button x:Name="PrevBtn"
                            Style="{StaticResource SubtleButtonStyle}"
                            Width="40" Height="40"
                            CornerRadius="20"
                            Padding="0"
                            Click="OnPrevPage">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                                  Glyph="&#xE76C;"
                                  FontSize="14" />
                    </Button>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="PageTitle"
                                   Text=""
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="PageSub"
                                   Text=""
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Button x:Name="NextBtn"
                            Style="{StaticResource SubtleButtonStyle}"
                            Width="40" Height="40"
                            CornerRadius="20"
                            Padding="0"
                            Click="OnNextPage">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                                  Glyph="&#xE76B;"
                                  FontSize="14" />
                    </Button>
                </StackPanel>

                <!-- צד שמאל: חיפוש בדף -->
                <AutoSuggestBox x:Name="PageSearchBox"
                                Grid.Column="2"
                                Width="240"
                                Height="36"
                                PlaceholderText="חפש בדף..."
                                QueryIcon="Find"
                                 FontSize="13"
                                VerticalAlignment="Center"
                                TextChanged="OnPageSearchTextChanged"
                                QuerySubmitted="OnPageSearchQuerySubmitted" />
            </Grid>
        </Grid>

        <!-- ===== BODY (3 columns: nav | text | witnesses) ===== -->
        <Grid Grid.Row="2" x:Name="BodyGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="260" MinWidth="0" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" MinWidth="400" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition x:Name="WitnessColumn" Width="450" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- ── NAV PANEL: מסכתות + דפים ── -->
            <Grid x:Name="NavPanel" Grid.Column="0" Padding="8,4,8,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- חיפוש מסכת + דף -->
                <AutoSuggestBox x:Name="QuickNavBox"
                                Grid.Row="0"
                                PlaceholderText="חפש מסכת ודף..."
                                QueryIcon="Find"
                                 FontSize="13"
                                Margin="4,4,4,8"
                                QuerySubmitted="OnQuickNavQuerySubmitted" />

                <!-- שתי רשימות זו לצד זו, בתוך כרטיס Fluent -->
                <Border Grid.Row="1"
                        CornerRadius="{StaticResource CardCornerRadius}"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="92" />
                        </Grid.ColumnDefinitions>

                        <!-- רשימת מסכתות -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="MasechetHeader"
                                       Grid.Row="0"
                                       Text="מסכתות"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Padding="10,12,10,6"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       CharacterSpacing="50" />
                            <ListView x:Name="MasechetList"
                                      Grid.Row="1"
                                         FontSize="13"
                                      SelectionMode="Single"
                                      SelectionChanged="OnMasechetSelected"
                                      Background="Transparent">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="8,8" />
                                        <Setter Property="MinHeight" Value="36" />
                                        <Setter Property="CornerRadius" Value="6" />
                                        <Setter Property="Margin" Value="4,1" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </Grid>

                        <!-- מפריד דק -->
                        <Border Grid.Column="1"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- רשימת דפים -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="PageHeader"
                                       Grid.Row="0"
                                       Text="דפים"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Padding="6,12,6,6"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       CharacterSpacing="50" />
                            <ListView x:Name="PageList"
                                      Grid.Row="1"
                                         FontSize="14"
                                      SelectionMode="Single"
                                      SelectionChanged="OnPageSelected"
                                      Background="Transparent">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="4,8" />
                                        <Setter Property="MinHeight" Value="36" />
                                        <Setter Property="CornerRadius" Value="6" />
                                        <Setter Property="Margin" Value="4,1" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- splitter דק -->
            <Border Grid.Column="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- ── TEXT AREA ── -->
            <ScrollViewer x:Name="TextScroll"
                          Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0"
                          Background="Transparent">
                <StackPanel x:Name="TextContainer"
                            Padding="16,16,16,40"
                            Spacing="8" />
            </ScrollViewer>

            <Border Grid.Column="3" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- ── WITNESS PANEL ── -->
            <controls:WitnessPanel x:Name="WitnessPanelView"
                                   Grid.Column="4" />
        </Grid>

        <!-- ===== Copyright Popup Overlay ===== -->
        <Grid x:Name="CopyrightOverlay"
              Grid.RowSpan="3"
              Background="#80000000"
              Visibility="Collapsed"
              Tapped="OnOverlayTapped">
            <Border x:Name="CopyrightCard"
                    Width="580"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    Padding="28,24,28,28"
                    Tapped="OnCardTapped">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <StackPanel Spacing="18">

                    <!-- ===== Fluent Header (W11 Settings style): icon + name + tagline ===== -->
                    <StackPanel Orientation="Horizontal" Spacing="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Border Width="64" Height="64"
                                CornerRadius="12"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Image Source="ms-appx:///Assets/AppIcon.png"
                                   Width="44" Height="44"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="סינופסיס תלמוד בבלי"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="השוואת נוסחאות התלמוד הבבלי בין כתבי יד וגרסאות דפוס"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       MaxWidth="380"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <!-- ===== הערת שימוש ===== -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="הערת שימוש"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock TextWrapping="Wrap"
                                   FontSize="13"
                                   LineHeight="20"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                            <Run Text="שים לב כי כל החומר כאן לוקט מתוכן השייך משפטית לאתר" />
                            <Run Text=" &quot;פרידברג – הכי גרסינן&quot;," FontWeight="SemiBold" />
                            <Run Text=" והשימוש בו מותר אך ורק לצורך שימוש פרטי ולא לצורך מסחרי!" />
                        </TextBlock>
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <!-- ===== אודות ===== -->
                    <StackPanel Spacing="10">
                        <TextBlock Text="אודות"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        <!-- מאגר פרידברג -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                                      Glyph="&#xE82D;"
                                      FontSize="14"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="המאגר המקורי – פרידברג, הכי גרסינן:"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <HyperlinkButton NavigateUri="https://fjms.genizah.org/?eraseCache=true"
                                             Content="fjms.genizah.org"
                                             FontSize="12"
                                             Padding="0,2" />
                        </StackPanel>

                        <!-- GitHub - הפרויקט הזה (Windows) -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <PathIcon Width="15" Height="15"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                      Data="M8 0C3.58 0 0 3.58 0 8C0 11.54 2.29 14.53 5.47 15.59C5.87 15.66 6.02 15.42 6.02 15.21C6.02 15.02 6.01 14.39 6.01 13.72C4 14.09 3.48 13.23 3.32 12.78C3.23 12.55 2.84 11.84 2.5 11.65C2.22 11.5 1.82 11.13 2.49 11.12C3.12 11.11 3.57 11.7 3.72 11.94C4.44 13.15 5.59 12.81 6.05 12.6C6.12 12.08 6.33 11.73 6.56 11.53C4.78 11.33 2.92 10.64 2.92 7.58C2.92 6.71 3.23 5.99 3.74 5.43C3.66 5.23 3.38 4.41 3.82 3.31C3.82 3.31 4.49 3.1 6.02 4.13C6.66 3.95 7.34 3.86 8.02 3.86C8.7 3.86 9.38 3.95 10.02 4.13C11.55 3.09 12.22 3.31 12.22 3.31C12.66 4.41 12.38 5.23 12.3 5.43C12.81 5.99 13.12 6.7 13.12 7.58C13.12 10.65 11.25 11.33 9.47 11.53C9.76 11.78 10.01 12.26 10.01 13.01C10.01 14.08 10 14.94 10 15.21C10 15.42 10.15 15.67 10.55 15.59C13.71 14.53 16 11.53 16 8C16 3.58 12.42 0 8 0Z" />
                            <TextBlock Text="פרויקט זה ב-GitHub:"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <HyperlinkButton NavigateUri="https://github.com/abaye123/TalmudFormulas"
                                             Content="abaye123/TalmudFormulas"
                                             FontSize="12"
                                             Padding="0,2" />
                        </StackPanel>

                        <!-- GitHub - הפרויקט המקורי בפייתון -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <PathIcon Width="15" Height="15"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                      Opacity="0.7"
                                      Data="M8 0C3.58 0 0 3.58 0 8C0 11.54 2.29 14.53 5.47 15.59C5.87 15.66 6.02 15.42 6.02 15.21C6.02 15.02 6.01 14.39 6.01 13.72C4 14.09 3.48 13.23 3.32 12.78C3.23 12.55 2.84 11.84 2.5 11.65C2.22 11.5 1.82 11.13 2.49 11.12C3.12 11.11 3.57 11.7 3.72 11.94C4.44 13.15 5.59 12.81 6.05 12.6C6.12 12.08 6.33 11.73 6.56 11.53C4.78 11.33 2.92 10.64 2.92 7.58C2.92 6.71 3.23 5.99 3.74 5.43C3.66 5.23 3.38 4.41 3.82 3.31C3.82 3.31 4.49 3.1 6.02 4.13C6.66 3.95 7.34 3.86 8.02 3.86C8.7 3.86 9.38 3.95 10.02 4.13C11.55 3.09 12.22 3.31 12.22 3.31C12.66 4.41 12.38 5.23 12.3 5.43C12.81 5.99 13.12 6.7 13.12 7.58C13.12 10.65 11.25 11.33 9.47 11.53C9.76 11.78 10.01 12.26 10.01 13.01C10.01 14.08 10 14.94 10 15.21C10 15.42 10.15 15.67 10.55 15.59C13.71 14.53 16 11.53 16 8C16 3.58 12.42 0 8 0Z" />
                            <TextBlock Text="הפרויקט המקורי (Python):"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <HyperlinkButton NavigateUri="https://github.com/ACHI-GARCINAN/ACHI-GARCINAN"
                                             Content="ACHI-GARCINAN"
                                             FontSize="12"
                                             Padding="0,2" />
                        </StackPanel>

                        <!-- מייל -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                                      Glyph="&#xE715;"
                                      FontSize="14"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="תגובות והערות:"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <HyperlinkButton x:Name="MailHyperlink"
                                             Content="talmud1239@gmail.com"
                                             FontSize="12"
                                             Padding="0,2"
                                             Click="OnOpenMail" />
                            <Button x:Name="CopyMailBtn"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Padding="6,4"
                                    CornerRadius="6"
                                    Click="OnCopyMail"
                                    ToolTipService.ToolTip="העתק כתובת מייל">
                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                                          Glyph="&#xE8C8;"
                                          FontSize="13" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
