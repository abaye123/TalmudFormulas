<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TalmudFormulas.Views.Controls.SectionBlock"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    PointerEntered="OnPointerEntered"
    PointerExited="OnPointerExited"
    Tapped="OnTapped">

    <Border x:Name="OuterBorder"
            CornerRadius="10"
            Margin="4,2"
            Padding="18,12,18,14"
            BorderThickness="1">
        <StackPanel Spacing="8">
            <Border x:Name="TagBorder"
                    HorizontalAlignment="Right"
                    CornerRadius="10"
                    Padding="10,3">
                <TextBlock x:Name="TagText"
                           FontSize="11"
                           FontWeight="SemiBold" />
            </Border>
            <!-- IsHitTestVisible=False כדי שלחיצה על הטקסט תיקלט כלחיצה על הקטע
                 (RichTextBlock עם IsTextSelectionEnabled תופס את אירועי המגע).
                 בחירת טקסט והעתקה זמינים בכרטיסי עדי-הנוסח בפאנל הצדדי. -->
            <RichTextBlock x:Name="TextBlockMain"
                           TextWrapping="Wrap"
                           IsHitTestVisible="False"
                           TextAlignment="Left"
                           LineHeight="26"
                           FlowDirection="RightToLeft" />
        </StackPanel>
    </Border>
</UserControl>
