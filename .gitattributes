# Git LFS — קובץ ה-DB גדול מדי לאחסון רגיל
Assets/talmud.db filter=lfs diff=lfs merge=lfs -text

# Line endings
* text=auto
*.cs text eol=crlf
*.xaml text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.manifest text eol=crlf
*.json text eol=lf
*.md text eol=lf

# Binary files
*.ico binary
*.png binary
*.jpg binary
*.db binary
